---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource/amiri/arabic-400.css';
import '@fontsource/amiri/arabic-700.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Companion from '../components/Companion.astro';
import { companion } from '../data/companion';
import { site } from '../data/site';

interface Props {
  title?: string;
  showCompanion?: boolean;
  description?: string;
}
const { title, description = site.description, showCompanion = true } = Astro.props;
const fullTitle = title ? `${title} · Rafeeq` : `Rafeeq · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fffefa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#011918" media="(prefers-color-scheme: dark)" />
    <meta name="google-play-app" content="app-id=com.satechdev.rafeeqapp" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rafeeq" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/google-sans.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MobileApplication',
      name: 'Rafeeq',
      operatingSystem: 'Android',
      applicationCategory: 'LifestyleApplication',
      description: site.description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      downloadUrl: site.playStoreUrl,
    })} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {showCompanion && <Companion script={companion} />}
    <script>
      // Fade sections in as they enter the viewport; re-armed after each
      // client-side navigation.
      function armReveal() {
        const items = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => observer.observe(el));
      }
      document.addEventListener('astro:page-load', armReveal);
    </script>
    <style is:global>
      .skip {
        position: absolute;
        left: -999px;
        top: 8px;
        padding: 10px 16px;
        background: var(--primary-bg);
        color: var(--primary-fg);
        border-radius: 10px;
        z-index: 100;
      }
      .skip:focus {
        left: 8px;
      }
    </style>
  </body>
</html>
