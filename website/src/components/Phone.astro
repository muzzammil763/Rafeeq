---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A device frame around a real app screenshot. Width is set by the parent
// through the `--w` custom property. `peek` drops the frame edge on one
// side for screenshots that continue past the stage (the stage clips them).
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  style?: string;
  eager?: boolean;
  sizes?: string;
  peek?: 'top' | 'bottom';
}
const {
  src,
  alt,
  class: className,
  style,
  eager = false,
  sizes = '(max-width: 720px) 60vw, 320px',
  peek,
} = Astro.props;
---

<div class:list={['phone', className, peek && `peek-${peek}`]} style={style}>
  <Image
    src={src}
    alt={alt}
    widths={[360, 540, 760]}
    sizes={sizes}
    format="webp"
    quality={82}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</div>

<style>
  .phone {
    --w: 300px;
    width: var(--w);
    padding: calc(var(--w) * 0.03);
    border-radius: calc(var(--w) * 0.16);
    background: #121514;
    box-shadow:
      0 0 0 calc(var(--w) * 0.006) #2d3331,
      var(--shadow);
    flex: none;
  }
  .phone :global(img) {
    width: 100%;
    border-radius: calc(var(--w) * 0.13);
  }
  .peek-bottom {
    padding-bottom: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .peek-bottom :global(img) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .peek-top {
    padding-top: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  .peek-top :global(img) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
</style>
