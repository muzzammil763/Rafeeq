---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A device frame around a real app screenshot. Width is set by the parent
// through the `--w` custom property. Keep the complete screenshot visible.
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  style?: string;
  eager?: boolean;
  sizes?: string;
}
const {
  src,
  alt,
  class: className,
  style,
  eager = false,
  sizes = '(max-width: 720px) 60vw, 320px',
} = Astro.props;
---

<div class:list={['phone', className]} style={style}>
  <Image
    src={src}
    alt={alt}
    widths={[360, 540, 760]}
    sizes={sizes}
    format="webp"
    quality={82}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</div>

<style>
  .phone {
    --w: 300px;
    width: var(--w);
    max-width: 100%;
    overflow: hidden;
    padding: calc(var(--w) * 0.03);
    border-radius: calc(var(--w) * 0.16);
    background: #121514;
    box-shadow:
      0 0 0 calc(var(--w) * 0.006) #2d3331,
      var(--shadow);
    flex: none;
  }
  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--w) * 0.13);
  }
</style>
