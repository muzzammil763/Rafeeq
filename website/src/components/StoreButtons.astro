---
import { site } from '../data/site';
interface Props {
  invert?: boolean;
}
const { invert = false } = Astro.props;
---

<div class:list={['stores', { invert }]}>
  <a class="btn btn-primary" href={site.playStoreUrl} rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M3.6 1.8c-.3.3-.5.8-.5 1.4v17.6c0 .6.2 1.1.5 1.4l9.9-10.2zM14.8 13.3l2.9 2.9-11.6 6.6c-.4.2-.8.3-1.1.2zM18.9 9l3 1.7c1 .6 1 1.9 0 2.5l-3 1.7-3.2-3zM6.1 1.2l11.6 6.6-2.9 2.9L5 .9c.3-.1.7 0 1.1.3z"></path>
    </svg>
    <span><small>Get it on</small>Google Play</span>
  </a>
  <span class="btn btn-ghost soon" aria-disabled="true">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M16.4 12.6c0-2.5 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.3.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.8-1.1-2.8-4.2zM14 5.1c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"></path>
    </svg>
    <span><small>Coming soon to the</small>App Store</span>
  </span>
</div>

<style>
  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .soon {
    cursor: default;
  }
  .soon:hover {
    transform: none;
  }
  /* On the deep-teal call-to-action card in both themes. */
  .invert .btn-primary {
    background: #fce6bc;
    color: #033736;
  }
  .invert .btn-ghost {
    background: transparent;
    color: #fce6bc;
    border-color: rgba(252, 230, 188, 0.3);
  }
</style>
